{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment_perfil": "PERFIL OPUS-ONLY — Opus 5 em tudo, janela 1M explicita via sufixo [1m] no model. NAO adicionar CLAUDE_CODE_DISABLE_1M_CONTEXT aqui: e ela que derruba a janela pra 200K. effortLevel maximo aceito em arquivo e 'xhigh'; 'max' so por sessao (/effort max ou CLAUDE_CODE_EFFORT_LEVEL=max no env).",
  "model": "opus[1m]",
  "effortLevel": "xhigh",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5"
  },
  "permissions": {
    "_comment": "Permissoes do projeto - AUDITOR. Os controles (gate de escrita e redacao de segredos) sao Python 3 sem dependencia externa; a stack do EXECUTOR continua pendente (P-09). Allow-list enxuta: git, testes e validacao de formato.",
    "defaultMode": "plan",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(python3 -m json.tool:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(node -c:*)",
      "Bash(node --check:*)",
      "Bash(shellcheck:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/id_rsa*)",
      "Read(./**/auth.json)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(wget * | sh:*)",
      "Bash(wget * | bash:*)"
    ],
    "ask": [
      "Bash(sudo:*)",
      "Bash(crontab:*)",
      "Bash(systemctl:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(npm install:*)",
      "Bash(cargo add:*)",
      "Bash(gh pr create:*)",
      "Bash(gh issue create:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/skills/auditor/hooks/write-gate.py\"",
            "timeout": 5,
            "statusMessage": "auditor: gate de escrita"
          }
        ]
      }
    ],
    "_comment_auditor": "PreToolUse write-gate: enforca write_policy=auditor-only FORA do modelo (T-03). So atua durante um ciclo (AUDITOR_CYCLE_ID no ambiente) — fora dele e transparente, senao travaria o desenvolvimento normal deste repo."
  }
}
